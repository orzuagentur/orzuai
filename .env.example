# OrzuAI Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or real secrets to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public base URL of the application (used for auth redirects and email links)
NEXT_PUBLIC_APP_URL=https://orzuaibot.vercel.app

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address in Resend
# Format: "OrzuAI <noreply@yourdomain.com>" or "noreply@yourdomain.com"
RESEND_FROM_EMAIL=noreply@orzuit.com

# -----------------------------------------------------------------------------
# Gemini (AI)
# -----------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: override default Gemini model
# Override on Vercel/local if needed (must match a valid Gemini API model id)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# OpenAI (optional multi-model provider)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Anthropic Claude (optional multi-model provider)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Google OAuth (Supabase Auth provider)
# Required for Google Login — configure in Supabase Dashboard or local Supabase
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# Required for webhook verification and incoming message signature checks
# -----------------------------------------------------------------------------

# Webhook verify token (must match Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Meta App Secret (required for webhook signature validation)
WHATSAPP_APP_SECRET=your-meta-app-secret

# Meta App ID (public — used by Instagram Embedded Signup JavaScript SDK)
NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# Optional: only needed if you use WhatsApp Embedded Signup
# NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-config-id

# Optional: Graph API version (default: v25.0)
WHATSAPP_API_VERSION=v25.0

# -----------------------------------------------------------------------------
# Instagram Direct (Meta) — v2 prepare (Phase 8.6 API)
# Uses same Meta App ID and App Secret as WhatsApp
# -----------------------------------------------------------------------------

# Embedded Signup configuration ID for Instagram (Meta Developer Console)
NEXT_PUBLIC_INSTAGRAM_EMBEDDED_SIGNUP_CONFIG_ID=your-instagram-embedded-signup-config-id

# Webhook verify token for Instagram (Meta Developer Console)
INSTAGRAM_VERIFY_TOKEN=your-instagram-webhook-verify-token

# Webhook callback URL (Meta Developer Console → Instagram → Webhooks):
# https://your-domain.com/api/webhooks/instagram

# -----------------------------------------------------------------------------
# Website Forms — inbound leads from any CMS
# Webhook URL is generated per business after enabling in Integrations → Website Forms
# Example: https://your-domain.com/api/webhooks/website-forms/{webhook_token}
# Optional header for server-side POST: X-OrzuAI-Api-Key: {api_key_from_dashboard}
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Website Knowledge Sync — crawl site → knowledge_base for all AI channels
# Cron (Vercel): GET /api/cron/sync-website-knowledge with Authorization: Bearer {CRON_SECRET}
# -----------------------------------------------------------------------------

CRON_SECRET=your-random-cron-secret-min-16-chars

# -----------------------------------------------------------------------------
# Telegram Bot API — Phase 8.7
# Requires HTTPS NEXT_PUBLIC_APP_URL (same as production app URL)
# Webhook URL registered automatically per bot: /api/webhooks/telegram
# Per-bot webhook secrets are stored in telegram_connections (no env var required)
# -----------------------------------------------------------------------------

# Optional legacy global secret (unused when connecting via Integrations UI)
TELEGRAM_WEBHOOK_SECRET=

# OrzuAI Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or real secrets to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public base URL of the application (used for auth redirects and email links)
NEXT_PUBLIC_APP_URL=https://orzuaibot.vercel.app

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address in Resend
# Format: "OrzuAI <noreply@yourdomain.com>" or "noreply@yourdomain.com"
RESEND_FROM_EMAIL=noreply@orzuit.com

# -----------------------------------------------------------------------------
# Gemini (AI)
# -----------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: override default Gemini model
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Google OAuth (Supabase Auth provider)
# Required for Google Login — configure in Supabase Dashboard or local Supabase
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# Required for webhook verification and incoming message signature checks
# -----------------------------------------------------------------------------

# Webhook verify token (must match Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Meta App Secret (for webhook signature validation and Embedded Signup token exchange)
WHATSAPP_APP_SECRET=your-meta-app-secret

# Meta App ID (public — used by Embedded Signup JavaScript SDK)
NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# Embedded Signup configuration ID from Meta Developer Console
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Optional: Graph API version (default: v21.0)
WHATSAPP_API_VERSION=v21.0

# OrzuAI Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or real secrets to version control.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Public base URL of the application (used for auth redirects and email links)
NEXT_PUBLIC_APP_URL=https://orzux.com

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address in Resend
# Format: "OrzuAI <noreply@yourdomain.com>" or "noreply@yourdomain.com"
RESEND_FROM_EMAIL=noreply@orzux.com

# -----------------------------------------------------------------------------
# Gemini (AI)
# -----------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: override default Gemini model
# Override on Vercel/local if needed (must match a valid Gemini API model id)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# OpenAI (optional multi-model provider)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Anthropic Claude (optional multi-model provider)
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Google OAuth (Supabase Auth provider)
# Required for Google Login — configure in Supabase Dashboard or local Supabase
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# WhatsApp Business API via 360dialog
# Inbound webhook (per number): https://orzux.com/api/webhooks/whatsapp
# Partner webhook (onboarding events): https://orzux.com/api/webhooks/360dialog-partner
# -----------------------------------------------------------------------------
#
# Embedded Signup (Integrated Onboarding) — connect a number in ~1 minute from Integrations
# Partner Hub: set redirect URL to https://orzux.com/dashboard/integrations/whatsapp
# and partner webhook to https://orzux.com/api/webhooks/360dialog-partner
NEXT_PUBLIC_DIALOG360_PARTNER_ID=
DIALOG360_PARTNER_API_KEY=
# Optional: verify x-360dialog-signature on partner webhooks (recommended in production)
# DIALOG360_PLATFORM_SECRET=
#
# Manual fallback: each business can paste Number API key + Phone number ID in Integrations
# Get credentials from https://hub.360dialog.com
#
# Sandbox (dev/testing only) — uses waba-sandbox.360dialog.io instead of production API
# DIALOG360_USE_SANDBOX=true
# Or override the API host explicitly:
# DIALOG360_API_BASE=https://waba-sandbox.360dialog.io
#
# Optional: only if you validate Meta-style webhook signatures (usually not needed for 360dialog)
# WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# Website Forms — inbound leads from any CMS
# Webhook URL is generated per business after enabling in Integrations → Website Forms
# Example: https://orzux.com/api/webhooks/website-forms/{webhook_token}
# Optional header for server-side POST: X-OrzuAI-Api-Key: {api_key_from_dashboard}
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Website Knowledge Sync — crawl site → knowledge_base for all AI channels
# Cron (Vercel): GET /api/cron/sync-website-knowledge with Authorization: Bearer {CRON_SECRET}
# -----------------------------------------------------------------------------

CRON_SECRET=your-random-cron-secret-min-16-chars

# -----------------------------------------------------------------------------
# Messaging scale (Phase 3–4) — recommended for production inbox
# -----------------------------------------------------------------------------
# Enable Realtime replication in Supabase Dashboard for: messages, conversations,
# message_deliveries (required for live inbox).
#
# Optional CDN origin for chat media signed URLs (e.g. Supabase custom domain)
# MEDIA_CDN_URL=https://cdn.yourdomain.com
#
# Upstash Redis — hot cache for signed media URLs (falls back to Postgres)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# QStash — durable webhook/delivery/hydration workers (primary queue drain)
# Create at https://console.upstash.com/qstash
# Worker URLs (base: https://orzux.com): /api/workers/webhook-queue, /api/workers/inbound-media-hydration,
# /api/workers/outbound-thumbnail, /api/workers/message-deliveries
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
#
# Parallel jobs per worker invocation (default: 5, max: 25)
# WORKER_CONCURRENCY=5
#
# Cron fallback (Bearer CRON_SECRET): /api/cron/webhook-queue, /api/cron/message-deliveries,
# /api/cron/ai-health (drains ai_reply_jobs + ai_orchestration_jobs)
# Health + drain: GET /api/cron/messaging-health (every 2 min recommended)
# See README.md → Operations runbook for backlog / hydration troubleshooting.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Telegram Bot API — Phase 8.7
# Requires HTTPS NEXT_PUBLIC_APP_URL (same as production app URL)
# Webhook URL registered automatically per bot: https://orzux.com/api/webhooks/telegram
# Per-bot webhook secrets are stored in telegram_connections (no env var required)
# -----------------------------------------------------------------------------

# Optional legacy global secret (unused when connecting via Integrations UI)
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Stripe Billing (subscription checkout + Customer Portal)
# Webhook: https://orzux.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# Enable Customer Portal in Stripe Dashboard → Settings → Billing → Customer portal
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Recurring Price IDs from Stripe Dashboard (Products → each plan → Price ID)
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly

# -----------------------------------------------------------------------------
# Web Push (new-lead notifications when user is away from the site)
# Generate keys: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# mailto: or https: contact for the push application server
VAPID_SUBJECT=mailto:support@orzux.com

# -----------------------------------------------------------------------------
# AI Voice Agent (outbound callback after order + inbound AI answers)
# Configure per business in Dashboard → Integrations → AI Voice
# Cron: GET /api/cron/voice-callbacks with Authorization: Bearer {CRON_SECRET}
# -----------------------------------------------------------------------------

# Twilio (recommended for start) — buy E.164 number in Twilio Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Inbound webhook on Twilio number:
# https://orzux.com/api/webhooks/voice/inbound?businessId={business_uuid}
# Outbound TwiML URL:
# https://orzux.com/api/webhooks/voice/outbound?businessId={business_uuid}

# Optional: Retell AI or Vapi (set provider in dashboard voice settings)
RETELL_API_KEY=
VAPI_API_KEY=

# -----------------------------------------------------------------------------
# Load tests (scripts/load-tests — optional, not required for app runtime)
# -----------------------------------------------------------------------------

# Inbox concurrent sessions: npm run load-test:inbox
# LOAD_TEST_EMAIL=
# LOAD_TEST_PASSWORD=
# LOAD_TEST_BUSINESS_ID=

# Webhook throughput: npm run load-test:webhooks
# LOAD_TEST_WEBHOOK_COUNT=1000
# LOAD_TEST_WEBHOOK_DURATION_SEC=60
# LOAD_TEST_WEBHOOK_CHANNEL=whatsapp
# LOAD_TEST_INBOX_SESSIONS=100
# LOAD_TEST_INBOX_ROUNDS=3
